#!/usr/bin/env zsh

fff() {
  [ -n "$1" ] || { echo "Usage: fff <pattern>"; return 1; }
  find . -iname "*$1*"
}

# Busca texto en el directorio actual sin distinguir mayúsculas. Con ripgrep
# omite lo ignorado por .gitignore (node_modules, vendor, target...); si no, grep.
ggg() {
  [ -n "$1" ] || { echo "Usage: ggg <pattern>"; return 1; }
  if (( $+commands[rg] )); then
    rg -i -- "$1"
  else
    grep -ri -- "$1" .
  fi
}

extractfile() {
  if [ -f "$1" ]; then
    case "$1" in
      *.tar|*.tar.bz2|*.tar.gz|*.tar.xz|*.tar.zst|*.tbz2|*.tgz|*.txz)
                          tar xf "$1" ;;
      *.bz2)              bunzip2 "$1" ;;
      *.rar)              unrar x "$1" ;;
      *.gz)               gunzip "$1" ;;
      *.zip)              unzip "$1" ;;
      *.Z)                uncompress "$1" ;;
      *.7z)               7z x "$1" ;;
      *.xz)               xz -d "$1" ;;
      *.zst)              zstd -d "$1" ;;
      *)                  echo "'$1' cannot be extracted via extractfile()" ;;
    esac
  else
    echo "'$1' is not a valid file."
  fi
}

# Clima en la terminal (wttr.in). Ciudad opcional; por defecto, $CURRENT_LOCATION (zshenv).
clima() {
  curl -s "wttr.in/${(j:+:)@:-${CURRENT_LOCATION// /+}}?lang=es"
}

clima-hoy() {
  curl -s "wttr.in/${(j:+:)@:-${CURRENT_LOCATION// /+}}?1&lang=es"
}

luna() {
  curl -s "wttr.in/Moon?lang=es"
}

psgrep() {
  if [ -n "$1" ]; then
    echo "Grepping for processes matching $1..."
    ps aux | grep -i -- "$1" | grep -v grep
  else
    echo "!! Need name to grep for"
  fi
}

