#!/usr/bin/env zsh

fff() {
  [ -n "$1" ] || { echo "Usage: fff <pattern>"; return 1; }
  find . -iname "*$1*"
}

ggg() {
  grep -ri "$1" .;
}

extractfile() {
  if [ -f "$1" ]; then
    case "$1" in
      *.tar.bz2)          tar xjf "$1" ;;
      *.tar.gz)           tar xzf "$1" ;;
      *.bz2)              bunzip2 "$1" ;;
      *.rar)              unrar x "$1" ;;
      *.gz)               gunzip "$1" ;;
      *.tar)              tar xv "$1" ;;
      *.tbz2)             tar xjf "$1" ;;
      *.tgz)              tar xzf "$1" ;;
      *.zip)              unzip "$1" ;;
      *.Z)                uncompress "$1" ;;
      *.7z)               7z x "$1" ;;
      *.xz)               xz -d "$1" ;;
      *.zst)              zstd -d "$1" ;;
      *)                  echo "'$1' cannot be extracted via extractfile()" ;;
    esac
  else
    echo "'$1' is not a valid file."
  fi
}

psgrep() {
  if [ -n "$1" ]; then
    echo "Grepping for processes matching $1..."
    ps aux | grep -i -- "$1" | grep -v grep
  else
    echo "!! Need name to grep for"
  fi
}

