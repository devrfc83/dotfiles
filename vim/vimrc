packadd! fugitive
packadd! editorconfig   " incluido en Vim 9.2 (pack/dist/opt)
packadd! hlyank         " incluido en Vim 9.2; reemplaza a vim-highlightedyank
packadd! surround
packadd! vim-snippets
packadd! ultisnips
packadd! youcompleteme
packadd! emmet-vim
packadd! easyalign
packadd! easymotion
packadd! gitgutter
packadd! undotree
packadd! airline
packadd! endwise
packadd! vim-test
packadd! ale
packadd! dracula       " tema (dracula/vim); también el de airline

" ── Valores por defecto de Vim ────────────────────────────────────────────────
" Con ~/.vimrc presente, Vim no carga defaults.vim: sin él faltan ttimeoutlen
" (Esc tardaba timeoutlen = 500 ms), incsearch, wildmenu, showcmd, syntax on y
" "filetype plugin indent on".
unlet! skip_defaults_vim
source $VIMRUNTIME/defaults.vim
" defaults.vim restaura la posición del cursor; se usa la versión propia (más abajo)
autocmd! vimStartup BufReadPost

" ── Opciones ──────────────────────────────────────────────────────────────────
set autoindent
set backspace=indent,eol,start
set backupdir=~/.vim/backup//
set clipboard=unnamedplus   " requiere +clipboard: vimx (paquete vim-X11)
set cursorline
set directory=~/.vim/swap//
set encoding=utf-8
set hlsearch
set ignorecase
set smartcase
set laststatus=2
set lazyredraw
set mouse=a
set nowrap
set number relativenumber
set ruler
set scrolloff=8
set showmatch
set noshowmode              " airline ya muestra el modo
set splitbelow
set splitright
set timeoutlen=500
set undofile
set undodir=~/.vim/undodir
set updatetime=300
set visualbell
set wildmode=list:longest,longest:full

set termguicolors

" Paleta Dracula, como la terminal (scripts/lib/dracula.palette)
colorscheme dracula

set wildignore+=cache/*
set wildignore+=node_modules/*
set wildignore+=versions/*
set wildignore+=vendor/*

" ── Autocomandos ──────────────────────────────────────────────────────────────
" En un augroup con autocmd! para no duplicarlos al recargar el vimrc.
" Los espacios al final de línea los quita EditorConfig (trim_trailing_whitespace).
augroup vimrc
    autocmd!
    autocmd BufReadPre COMMIT_EDITMSG,MERGE_MSG,git-rebase-todo setlocal fileencodings=utf-8
    autocmd BufReadPost *
        \ if line("'\"") > 0 && line("'\"") <= line("$")
        \           && &filetype !~# 'commit\|gitrebase'
        \           && expand("%") !~ "ADD_EDIT.patch"
        \           && expand("%") !~ "addp-hunk-edit.diff" |
        \   exe "normal g`\"" |
        \ endif
    autocmd BufNewFile,BufRead *.patch set filetype=diff
    autocmd FileType diff
        \ highlight WhiteSpaceEOL ctermbg=red |
        \ match WhiteSpaceEOL /\(^+.*\)\@<=\s\+$/
augroup END

let g:EditorConfig_exclude_patterns = ['fugitive://.*', 'scp://.*']

